# Public browser configuration; RLS still controls all database access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Pontianak

# Server only. Foundation auth does not use these secrets.
SUPABASE_SECRET_KEY=
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT
NASA_FIRMS_BBOX=
NASA_FIRMS_SYNC_TOKEN=
AI_PROVIDER_API_KEY=
AI_SUMMARIZATION_ENABLED=false

# Server-side canonical origin for auth email links; add to Supabase redirect allowlist.
APP_ORIGIN=http://localhost:3000
